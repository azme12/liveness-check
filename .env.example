# Liveness API
LIVENESS_API_KEY=sk_test_liveness_dev
LIVENESS_DEBUG=false
LIVENESS_MONGODB_URL=mongodb://localhost:27018
LIVENESS_MONGODB_DB=liveness
LIVENESS_STORAGE_DIR=./storage
LIVENESS_MODELS_DIR=./models
LIVENESS_FACE_MATCH_THRESHOLD=0.45
LIVENESS_LIVENESS_THRESHOLD=0.5
LIVENESS_ALLOW_HEURISTIC_FALLBACK=true

# Docker Compose (API container uses mongodb://mongo:27017)
# Host tools (Beekeeper/Compass): mongodb://127.0.0.1:27018
# Browse collections: http://127.0.0.1:8081  (mongo-express)
