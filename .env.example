# Liveness API — used by local (non-Docker) runs
LIVENESS_API_KEY=sk_test_liveness_dev
LIVENESS_DEBUG=false
LIVENESS_DATABASE_URL=sqlite+aiosqlite:///./data/liveness.db
LIVENESS_STORAGE_DIR=./storage
LIVENESS_MODELS_DIR=./models
LIVENESS_FACE_MATCH_THRESHOLD=0.45
LIVENESS_LIVENESS_THRESHOLD=0.5
LIVENESS_ALLOW_HEURISTIC_FALLBACK=true

# Docker: DB is inside volume liveness-data → /app/data/liveness.db
# View tables: http://127.0.0.1:8080  (sqlite-web service)
