# Trustanova dashboard API
LIVENCUBE_MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/liveness
LIVENCUBE_MONGODB_DB=liveness
LIVENCUBE_JWT_SECRET=change-me-in-production
LIVENCUBE_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Set true only for local demo data (admin@trustanova.dev). Leave false in production.
LIVENCUBE_SEED_DEMO=false

# Verification engine (same MongoDB in production)
LIVENESS_MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/liveness
LIVENESS_MONGODB_DB=liveness
LIVENESS_ALLOW_HEURISTIC_FALLBACK=true
# OpenFace head pose (optional — auto-detects local FaceLandmarkImg build)
# LIVENESS_OPENFACE_BIN=/path/to/FaceLandmarkImg
# LIVENESS_OPENFACE_ENABLED=true
# LIVENESS_SELFIE_MAX_YAW=20
# LIVENESS_SELFIE_MAX_PITCH=15
# LIVENESS_SELFIE_MAX_ROLL=12
